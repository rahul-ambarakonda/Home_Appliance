# Application Configuration
FLASK_APP=app # Specifies the main Flask application package or file (e.g., 'app' for a package or 'run.py' for a script).
FLASK_ENV=development # Sets the Flask environment: 'development' enables debugging, 'production' disables it.
SECRET_KEY=your_super_secret_key_here # A secret key used by Flask for session management, cryptographic signing, etc. Generate a strong, random one.

# Database Configuration
DATABASE_URL=sqlite:///./instance/appliance.db # Connection string for the SQLite database. For SQLite, this is a file path.

# Server Configuration
PORT=5000 # The port on which the Flask backend server will listen.

# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:5000/api # The base URL for the backend API that the frontend (Vite React app) will connect to.